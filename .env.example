# Same-origin API path (recommended). Proxied by app/api/v1/[...path]/route.ts.
# Using http://127.0.0.1:8000 here breaks refresh-cookie login persistence.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-only: FastAPI origin for the Next.js API proxy
BACKEND_URL=http://127.0.0.1:8000

# Unilever study engine (analytics APIs). JWT is shared with MindSurve.
NEXT_PUBLIC_UNILEVER_API_BASE_URL=http://127.0.0.1:5000/api/v1
