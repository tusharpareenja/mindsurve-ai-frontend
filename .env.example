# Same-origin API path (recommended). Proxied by app/api/v1/[...path]/route.ts.
# Using http://127.0.0.1:8000 here breaks refresh-cookie login persistence.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-only: FastAPI origin for the Next.js API proxy
BACKEND_URL=http://127.0.0.1:8000

# Unilever study engine (analytics APIs). JWT is shared with MindSurve.
# Browser calls this directly — must be the real Unilever host in production.
NEXT_PUBLIC_UNILEVER_API_BASE_URL=http://127.0.0.1:5000/api/v1

# Chat uploads go browser → Azure Blob (SAS), then a tiny /uploads/complete
# call through BACKEND_URL. Files up to 25MB; no Vercel 4.5MB body limit.

# Google OAuth (same Google Cloud client as Unilever is fine if redirect URIs include this app)
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_SECRET=generate-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=



